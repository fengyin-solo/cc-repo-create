{
  "app_name": "影视剧组拍摄制作管理平台",
  "app_slug": "film-production-ops",
  "app_desc": "面向剧本分场、选角档期、拍摄通告、场地器材、后期特效与杀青结算的一体化剧组管理后台。",
  "frontend": "vue",
  "backend": "python",
  "port_frontend": 5173,
  "port_backend": 8000,
  "modules": [
    {
      "key": "script",
      "name": "剧本管理",
      "entity": "剧本",
      "fields": ["剧本编号", "剧本名称", "题材类型", "编剧姓名", "总集数", "当前版本", "终稿日期", "版权归属"],
      "statuses": ["创作中", "待审稿", "已定稿", "已归档"],
      "actions": ["提交审稿", "确认定稿", "归档剧本"],
      "action_targets": ["待审稿", "已定稿", "已归档"],
      "metrics": ["在写剧本", "待审稿剧本", "本月定稿"]
    },
    {
      "key": "scene",
      "name": "分场大纲",
      "entity": "分场表",
      "fields": ["场次编号", "所属剧本", "场景地点", "日戏夜戏", "出场人物", "预计时长", "拍摄难度", "分场状态"],
      "statuses": ["待编写", "已编写", "已审核", "已调整"],
      "actions": ["提交分场", "审核分场", "调整场次"],
      "action_targets": ["已编写", "已审核", "已调整"],
      "metrics": ["总场次数", "待编写场次", "夜戏场次"]
    },
    {
      "key": "casting",
      "name": "角色选角",
      "entity": "角色",
      "fields": ["角色编号", "角色名称", "角色类型", "候选演员", "试镜日期", "片酬区间", "签约状态", "角色说明"],
      "statuses": ["待试镜", "试镜中", "已定角", "已换角"],
      "actions": ["安排试镜", "确认定角", "更换演员"],
      "action_targets": ["试镜中", "已定角", "已换角"],
      "metrics": ["待定角色", "已定角角色", "试镜中角色"]
    },
    {
      "key": "crew",
      "name": "剧组人员",
      "entity": "剧组成员",
      "fields": ["成员编号", "姓名", "岗位职务", "所属组别", "联系电话", "进场日期", "离场日期", "在组状态"],
      "statuses": ["待进场", "在组", "已离场", "已请假"],
      "actions": ["办理进场", "办理离场", "登记请假"],
      "action_targets": ["在组", "已离场", "已请假"],
      "metrics": ["在组人数", "待进场人员", "今日请假"]
    },
    {
      "key": "notice",
      "name": "拍摄通告",
      "entity": "拍摄通告单",
      "fields": ["通告编号", "拍摄日期", "集合时间", "拍摄地点", "拍摄场次", "出勤人员", "用车安排", "通告状态"],
      "statuses": ["待下发", "已下发", "执行中", "已完成"],
      "actions": ["下发通告", "开始执行", "确认完成"],
      "action_targets": ["已下发", "执行中", "已完成"],
      "metrics": ["今日通告", "待下发通告", "未完成通告"]
    },
    {
      "key": "location",
      "name": "场地租用",
      "entity": "拍摄场地",
      "fields": ["场地编号", "场地名称", "场地类型", "所属区域", "可租时段", "场地费用", "对接联系人", "租用状态"],
      "statuses": ["待洽谈", "已签约", "使用中", "已退场"],
      "actions": ["签约场地", "确认进场", "办理退场"],
      "action_targets": ["已签约", "使用中", "已退场"],
      "metrics": ["已签约场地", "使用中场地", "待洽谈场地"]
    },
    {
      "key": "prop",
      "name": "道具管理",
      "entity": "道具",
      "fields": ["道具编号", "道具名称", "道具类别", "所属场次", "保管人员", "采购单价", "使用状态", "归还日期"],
      "statuses": ["在库", "已借出", "已归还", "已损毁"],
      "actions": ["借出道具", "归还道具", "登记损毁"],
      "action_targets": ["已借出", "已归还", "已损毁"],
      "metrics": ["在库道具", "已借出道具", "待归还道具"]
    },
    {
      "key": "costume",
      "name": "服装造型",
      "entity": "戏服",
      "fields": ["服装编号", "服装名称", "角色归属", "尺码规格", "造型师", "使用场次", "当前状态", "清洗记录"],
      "statuses": ["待定妆", "已定妆", "使用中", "已归还"],
      "actions": ["安排定妆", "确认使用", "归还服装"],
      "action_targets": ["已定妆", "使用中", "已归还"],
      "metrics": ["待定妆服装", "使用中服装", "待清洗服装"]
    },
    {
      "key": "makeup",
      "name": "化妆造型",
      "entity": "妆造方案",
      "fields": ["方案编号", "角色名称", "造型风格", "特效需求", "化妆师", "试妆日期", "定妆照片", "方案状态"],
      "statuses": ["待设计", "待试妆", "已定妆", "已作废"],
      "actions": ["提交方案", "安排试妆", "作废方案"],
      "action_targets": ["待试妆", "已定妆", "已作废"],
      "metrics": ["待试妆方案", "已定妆方案", "特效妆造"]
    },
    {
      "key": "equipment",
      "name": "器材管理",
      "entity": "拍摄器材",
      "fields": ["器材编号", "器材名称", "器材类别", "品牌型号", "所属租赁商", "日租金", "领用人员", "器材状态"],
      "statuses": ["在库", "已领用", "维修中", "已退租"],
      "actions": ["办理领用", "归还器材", "送修登记"],
      "action_targets": ["已领用", "在库", "维修中"],
      "metrics": ["在库器材", "已领用器材", "维修中器材"]
    },
    {
      "key": "shooting",
      "name": "拍摄进度",
      "entity": "拍摄日",
      "fields": ["拍摄日编号", "拍摄日期", "拍摄地点", "计划场次", "完成场次", "有效工时", "超时情况", "拍摄状态"],
      "statuses": ["待拍摄", "拍摄中", "已收工", "已顺延"],
      "actions": ["开始拍摄", "确认收工", "申请顺延"],
      "action_targets": ["拍摄中", "已收工", "已顺延"],
      "metrics": ["计划拍摄日", "已完成拍摄日", "顺延天数"]
    },
    {
      "key": "footage",
      "name": "素材管理",
      "entity": "拍摄素材",
      "fields": ["素材编号", "素材类型", "拍摄日期", "文件大小", "存储介质", "转码格式", "备份位置", "素材状态"],
      "statuses": ["待转码", "转码中", "已归档", "已丢失"],
      "actions": ["提交转码", "确认归档", "登记丢失"],
      "action_targets": ["转码中", "已归档", "已丢失"],
      "metrics": ["待转码素材", "已归档素材", "存储占用"]
    },
    {
      "key": "edit",
      "name": "后期剪辑",
      "entity": "剪辑任务",
      "fields": ["任务编号", "所属集数", "剪辑师", "粗剪版本", "精剪版本", "交付日期", "修改轮次", "剪辑状态"],
      "statuses": ["待粗剪", "粗剪中", "待精剪", "已交付"],
      "actions": ["开始粗剪", "提交精剪", "确认交付"],
      "action_targets": ["粗剪中", "待精剪", "已交付"],
      "metrics": ["待粗剪任务", "精剪中任务", "已交付集数"]
    },
    {
      "key": "vfx",
      "name": "特效制作",
      "entity": "特效镜头",
      "fields": ["镜头编号", "所属集数", "特效类型", "制作供应商", "渲染帧数", "预估工时", "交付版本", "制作状态"],
      "statuses": ["待制作", "制作中", "待审核", "已完成"],
      "actions": ["开始制作", "提交审核", "确认完成"],
      "action_targets": ["制作中", "待审核", "已完成"],
      "metrics": ["制作中镜头", "待审核镜头", "已完成镜头"]
    },
    {
      "key": "review",
      "name": "审片意见",
      "entity": "审片记录",
      "fields": ["审片编号", "审片轮次", "审片人", "审片对象", "问题类型", "修改意见", "回复说明", "审片状态"],
      "statuses": ["待审片", "审片中", "待修改", "已通过"],
      "actions": ["发起审片", "提交意见", "确认通过"],
      "action_targets": ["审片中", "待修改", "已通过"],
      "metrics": ["待审片记录", "待修改意见", "已通过记录"]
    },
    {
      "key": "budget",
      "name": "预算科目",
      "entity": "预算科目",
      "fields": ["科目编号", "科目名称", "费用类别", "预算金额", "已用金额", "剩余额度", "审批人", "科目状态"],
      "statuses": ["待审批", "已批复", "执行中", "已超支"],
      "actions": ["提交审批", "确认批复", "标记超支"],
      "action_targets": ["已批复", "执行中", "已超支"],
      "metrics": ["预算总额", "已用金额", "超支科目"]
    },
    {
      "key": "expense",
      "name": "费用报销",
      "entity": "报销单",
      "fields": ["报销单号", "报销人", "费用类别", "发生日期", "报销金额", "票据张数", "所属科目", "报销状态"],
      "statuses": ["待提交", "待审核", "已通过", "已驳回", "已打款"],
      "actions": ["提交报销", "审核通过", "驳回报销"],
      "action_targets": ["待审核", "已通过", "已驳回"],
      "metrics": ["待审核报销", "本月报销额", "已驳回报销"]
    },
    {
      "key": "schedule",
      "name": "档期协调",
      "entity": "演员档期",
      "fields": ["档期编号", "演员姓名", "经纪公司", "可用起止日", "每日工时上限", "档期费用", "协调人", "档期状态"],
      "statuses": ["待协调", "已确认", "有冲突", "已取消"],
      "actions": ["确认档期", "登记冲突", "取消档期"],
      "action_targets": ["已确认", "有冲突", "已取消"],
      "metrics": ["已确认档期", "待协调档期", "冲突档期"]
    },
    {
      "key": "permit",
      "name": "外景许可",
      "entity": "拍摄许可",
      "fields": ["许可编号", "许可类型", "申请地点", "受理单位", "申请日期", "有效期至", "许可费用", "许可状态"],
      "statuses": ["待申请", "已受理", "已批准", "已驳回", "已过期"],
      "actions": ["提交申请", "确认批准", "驳回申请"],
      "action_targets": ["已受理", "已批准", "已驳回"],
      "metrics": ["待申请许可", "已批准许可", "即将过期许可"]
    },
    {
      "key": "wrap",
      "name": "杀青结算",
      "entity": "结算单",
      "fields": ["结算单号", "结算对象", "结算周期", "应结金额", "已付金额", "未付金额", "结算人", "结算状态"],
      "statuses": ["待核对", "核对中", "已确认", "已付清", "有争议"],
      "actions": ["发起核对", "确认结算", "标记争议"],
      "action_targets": ["核对中", "已付清", "有争议"],
      "metrics": ["待核对结算单", "本月结算额", "争议单数"]
    }
  ]
}

{
  "app_name": "园区通行与安全运营平台",
  "app_slug": "park-ops",
  "app_desc": "面向园区访客、门禁、车辆、巡检与设备运维的一体化运营后台。",
  "frontend": "vue",
  "backend": "python",
  "port_frontend": 5173,
  "port_backend": 8000,
  "modules": [
    {
      "key": "visitor",
      "name": "访客预约",
      "entity": "访客预约单",
      "fields": ["预约单号", "访客姓名", "联系电话", "来访事由", "通行区域", "有效时段", "接待人员"],
      "statuses": ["待审批", "已通过", "已拒绝", "已失效"],
      "actions": ["提交审批", "发放通行凭证", "撤销预约"],
      "action_targets": ["待审批", "已通过", "已失效"],
      "metrics": ["今日预约", "待审批数量", "逾期未离场"]
    },
    {
      "key": "access",
      "name": "门禁授权",
      "entity": "门禁授权单",
      "fields": ["授权编号", "持卡人", "门禁点位", "通行时段", "授权方式", "生效日期", "失效日期"],
      "statuses": ["待生效", "已生效", "已停用", "已过期"],
      "actions": ["启用授权", "停用授权", "续期授权"],
      "action_targets": ["已生效", "已停用", "已生效"],
      "metrics": ["生效授权", "待启用", "即将到期"]
    },
    {
      "key": "vehicle",
      "name": "车辆通行",
      "entity": "车辆通行证",
      "fields": ["车牌号码", "车辆类型", "通行证号", "所属单位", "通行区域", "有效期限", "驾驶人"],
      "statuses": ["待审核", "已发放", "已回收", "已作废"],
      "actions": ["审核通过", "回收通行证", "作废通行证"],
      "action_targets": ["已发放", "已回收", "已作废"],
      "metrics": ["在册车辆", "待审核", "临时通行"]
    },
    {
      "key": "patrol",
      "name": "巡检计划",
      "entity": "巡检计划表",
      "fields": ["计划名称", "巡检区域", "巡检频次", "责任班组", "开始日期", "结束日期", "巡检路线"],
      "statuses": ["草稿", "待执行", "执行中", "已完成"],
      "actions": ["下发计划", "暂停计划", "归档计划"],
      "action_targets": ["待执行", "草稿", "已完成"],
      "metrics": ["在途计划", "待下发", "本周完成率"]
    },
    {
      "key": "patroltask",
      "name": "巡检任务",
      "entity": "巡检任务单",
      "fields": ["任务编号", "所属计划", "巡检点位", "执行人员", "计划时间", "实际时间", "巡检结论"],
      "statuses": ["待接单", "进行中", "已提交", "已驳回"],
      "actions": ["接单", "提交结果", "驳回任务"],
      "action_targets": ["进行中", "已提交", "已驳回"],
      "metrics": ["待接单任务", "超时任务", "已提交结论"]
    },
    {
      "key": "device",
      "name": "设备台账",
      "entity": "设备档案",
      "fields": ["设备编号", "设备名称", "设备类型", "安装位置", "所属区域", "投运日期", "责任人"],
      "statuses": ["在用", "停用", "维修中", "已报废"],
      "actions": ["登记设备", "变更位置", "报修设备"],
      "action_targets": ["在用", "在用", "维修中"],
      "metrics": ["在册设备", "维修中设备", "待巡检设备"]
    },
    {
      "key": "fault",
      "name": "故障工单",
      "entity": "故障工单",
      "fields": ["工单编号", "故障设备", "故障描述", "紧急程度", "报修人", "受理班组", "期望完成时间"],
      "statuses": ["待受理", "处理中", "待验收", "已关闭"],
      "actions": ["受理工单", "派单处理", "关闭工单"],
      "action_targets": ["处理中", "处理中", "已关闭"],
      "metrics": ["待受理工单", "超时工单", "平均处理时长"]
    },
    {
      "key": "spare",
      "name": "备件库存",
      "entity": "备件出入库单",
      "fields": ["备件编码", "备件名称", "规格型号", "库存数量", "安全库存", "存放库位", "最近出入库"],
      "statuses": ["正常", "低于安全库存", "待补货", "已冻结"],
      "actions": ["出库领用", "入库登记", "盘点修正"],
      "action_targets": ["正常", "正常", "正常"],
      "metrics": ["在库种类", "低库存备件", "待补货清单"]
    },
    {
      "key": "alarm",
      "name": "告警中心",
      "entity": "告警事件",
      "fields": ["告警编号", "告警类型", "告警等级", "触发设备", "触发时间", "处理状态", "处理人"],
      "statuses": ["待确认", "已确认", "已处置", "已忽略"],
      "actions": ["确认告警", "处置告警", "忽略告警"],
      "action_targets": ["已确认", "已处置", "已忽略"],
      "metrics": ["今日告警", "待确认告警", "高等级告警"]
    },
    {
      "key": "dashboardmetric",
      "name": "运营看板",
      "entity": "看板指标",
      "fields": ["指标名称", "统计口径", "统计周期", "指标值", "环比变化", "更新时间"],
      "statuses": ["采集中", "已发布", "已下线"],
      "actions": ["发布指标", "刷新指标", "下线指标"],
      "action_targets": ["已发布", "采集中", "已下线"],
      "metrics": ["已发布指标", "采集中指标", "环比下降指标"]
    },
    {
      "key": "staff",
      "name": "人员权限",
      "entity": "账号授权",
      "fields": ["账号", "姓名", "所属部门", "角色", "数据范围", "授权状态", "最近登录"],
      "statuses": ["待开通", "已开通", "已停用"],
      "actions": ["开通账号", "变更角色", "停用账号"],
      "action_targets": ["已开通", "已开通", "已停用"],
      "metrics": ["在册账号", "待开通账号", "停用账号"]
    },
    {
      "key": "area",
      "name": "区域管理",
      "entity": "区域档案",
      "fields": ["区域编码", "区域名称", "上级区域", "区域类型", "责任人", "启用状态", "备注说明"],
      "statuses": ["已启用", "已停用"],
      "actions": ["启用区域", "停用区域", "调整上级"],
      "action_targets": ["已启用", "已停用", "已启用"],
      "metrics": ["启用区域", "停用区域", "待归口区域"]
    },
    {
      "key": "shift",
      "name": "班次排班",
      "entity": "排班表",
      "fields": ["排班日期", "班次名称", "值班班组", "值班人员", "交接事项", "排班状态"],
      "statuses": ["待确认", "已确认", "已交接", "已调班"],
      "actions": ["确认排班", "发起调班", "完成交接"],
      "action_targets": ["已确认", "已调班", "已交接"],
      "metrics": ["本周排班", "待确认班次", "交接未完成"]
    },
    {
      "key": "notice",
      "name": "消息通知",
      "entity": "通知记录",
      "fields": ["通知标题", "通知类型", "接收范围", "发送渠道", "发送时间", "阅读情况"],
      "statuses": ["待发送", "已发送", "已撤回"],
      "actions": ["发送通知", "撤回通知", "重发通知"],
      "action_targets": ["已发送", "已撤回", "已发送"],
      "metrics": ["待发送通知", "今日已发送", "未读通知"]
    },
    {
      "key": "auditlog",
      "name": "操作日志",
      "entity": "操作日志",
      "fields": ["操作时间", "操作账号", "操作模块", "操作类型", "操作对象", "操作结果"],
      "statuses": ["成功", "失败", "部分成功"],
      "actions": ["导出日志", "标记疑点", "归档日志"],
      "action_targets": ["成功", "部分成功", "成功"],
      "metrics": ["今日操作", "失败操作", "疑点日志"]
    },
    {
      "key": "report",
      "name": "报表导出",
      "entity": "报表任务",
      "fields": ["报表名称", "统计范围", "统计周期", "导出格式", "任务状态", "生成时间"],
      "statuses": ["排队中", "生成中", "已完成", "已失败"],
      "actions": ["生成报表", "重试任务", "下载报表"],
      "action_targets": ["生成中", "排队中", "已完成"],
      "metrics": ["排队任务", "生成中任务", "失败任务"]
    },
    {
      "key": "dict",
      "name": "数据字典",
      "entity": "字典项",
      "fields": ["字典编码", "字典名称", "所属分类", "字典值", "排序号", "启用状态"],
      "statuses": ["已启用", "已停用"],
      "actions": ["新增字典项", "停用字典项", "调整排序"],
      "action_targets": ["已启用", "已停用", "已启用"],
      "metrics": ["在用字典项", "停用字典项", "待归口分类"]
    },
    {
      "key": "setting",
      "name": "系统设置",
      "entity": "系统参数",
      "fields": ["参数编码", "参数名称", "参数值", "参数类型", "生效范围", "修改人"],
      "statuses": ["已生效", "待生效", "已回滚"],
      "actions": ["修改参数", "回滚参数", "生效参数"],
      "action_targets": ["待生效", "已回滚", "已生效"],
      "metrics": ["生效参数", "待生效参数", "本周变更次数"]
    }
  ]
}
